{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sjia:schema:s3-backup-source-1",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_sha256", "database", "cluster_id", "access_configuration_sha256", "file_references", "registrations", "captured_at"],
  "properties": {
    "schema_version": {"const": "s3-backup-source-1", "default": "s3-backup-source-1"},
    "binding_sha256": {"$ref": "#/$defs/digest"},
    "database": {"type": "string", "minLength": 1},
    "cluster_id": {"type": "string", "minLength": 1},
    "access_configuration_sha256": {"$ref": "#/$defs/digest"},
    "file_references": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "registrations": {"type": "array", "items": {"$ref": "urn:sjia:schema:s3-stored-object-1"}},
    "captured_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "patient_id", "object_key", "object_version", "checksum", "size_bytes", "status"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "patient_id": {"type": "string", "format": "uuid"},
        "object_key": {"type": "string", "minLength": 1, "format": "sjia-canonical-object-key"},
        "object_version": {"type": "string", "minLength": 1},
        "checksum": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "status": {"enum": ["quarantined", "available", "failed", "disposed"]}
      }
    }
  }
}
