{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sjia:schema:s3-restore-lineage-1",
  "type": "object", "additionalProperties": false,
  "required": ["generations"],
  "properties": {
    "schema_version": {"const": "s3-restore-lineage-1", "default": "s3-restore-lineage-1"},
    "generations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/generation"}}
  },
  "$defs": {
    "nullableDigest": {"anyOf": [{"$ref": "urn:sjia:schema:s3-backup-source-1#/$defs/digest"}, {"type": "null"}]},
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "parent_restore_id", "parent_mapping_sha256", "ancestor_sha256", "restore_root", "mapping", "mapping_sha256", "content_checkpoint", "created_at", "mapped_at"],
      "properties": {
        "schema_version": {"const": "s3-restore-generation-1", "default": "s3-restore-generation-1"},
        "generation": {"type": "integer", "minimum": 1},
        "parent_restore_id": {"anyOf": [{"type": "string", "format": "uuid", "not": {"const": "00000000-0000-0000-0000-000000000000"}}, {"type": "null"}]},
        "parent_mapping_sha256": {"$ref": "#/$defs/nullableDigest"},
        "ancestor_sha256": {"$ref": "#/$defs/nullableDigest"},
        "restore_root": {"type": "string", "format": "sjia-absolute-restore-root"},
        "mapping": {"$ref": "urn:sjia:schema:s3-restore-mapping-1"},
        "mapping_sha256": {"$ref": "urn:sjia:schema:s3-backup-source-1#/$defs/digest"},
        "content_checkpoint": {"$ref": "urn:sjia:schema:s3-consistent-backup-1#/$defs/checkpoint"},
        "created_at": {"type": "string", "format": "date-time"},
        "mapped_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [{
        "if": {"properties": {"generation": {"const": 1}}, "required": ["generation"]},
        "then": {"properties": {"parent_restore_id": {"type": "null"}, "parent_mapping_sha256": {"type": "null"}, "ancestor_sha256": {"type": "null"}}},
        "else": {"properties": {"parent_restore_id": {"type": "string"}, "parent_mapping_sha256": {"type": "string"}, "ancestor_sha256": {"type": "string"}}}
      }]
    }
  }
}
