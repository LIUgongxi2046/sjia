{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "backend-runtime-1 运行配置；具体值需要实际环境批准",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "environment", "api", "session", "limits", "tasks", "providers", "retention_policy_ids", "operations_contact_ref"],
  "properties": {
    "schema_version": {"const": "backend-runtime-1"},
    "environment": {"type": "string", "minLength": 1, "maxLength": 64},
    "archive_delta_visibility_config_id": {"type": "string", "format": "uuid", "description": "本人新增内容整理采用的准确visibility-1版本；使用该功能时必须配置。"},
    "observation_period_visibility_config_id": {"type": "string", "format": "uuid", "description": "本人观察资料采用的准确visibility-1版本；使用该功能时必须配置。"},
    "api": {"type": "object", "additionalProperties": false, "required": ["lock_timeout_ms", "statement_timeout_ms", "request_timeout_ms", "upload_timeout_ms", "max_json_bytes", "allowed_origins", "intent_ttl_seconds", "max_page_size", "poll_after_ms"], "properties": {
      "lock_timeout_ms": {"$ref": "#/$defs/positive"}, "statement_timeout_ms": {"$ref": "#/$defs/positive"}, "request_timeout_ms": {"$ref": "#/$defs/positive"}, "upload_timeout_ms": {"$ref": "#/$defs/positive"}, "max_json_bytes": {"$ref": "#/$defs/positive"}, "allowed_origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}}, "intent_ttl_seconds": {"$ref": "#/$defs/positive"}, "max_page_size": {"$ref": "#/$defs/positive"}, "poll_after_ms": {"$ref": "#/$defs/positive"}
    }},
    "session": {"type": "object", "additionalProperties": false, "required": ["absolute_ttl_seconds", "idle_ttl_seconds", "same_site", "secure", "http_only", "csrf_use_sessions", "csrf_header", "cookie_name", "return_paths"], "properties": {"absolute_ttl_seconds": {"$ref": "#/$defs/positive"}, "idle_ttl_seconds": {"$ref": "#/$defs/positive"}, "same_site": {"enum": ["Lax", "Strict"]}, "secure": {"const": true}, "http_only": {"const": true}, "csrf_use_sessions": {"const": true}, "csrf_header": {"const": "X-CSRFToken"}, "cookie_name": {"const": "__Host-sjia_session"}, "return_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["/home", "/records", "/account", "/associations"]}}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_query_length", "max_text_length", "max_decimal_digits", "max_record_fields", "max_upload_bytes", "max_pixels", "max_pages", "media_types", "rate_limits"], "properties": {"max_query_length": {"$ref": "#/$defs/positive"}, "max_text_length": {"$ref": "#/$defs/positive"}, "max_decimal_digits": {"$ref": "#/$defs/positive"}, "max_record_fields": {"$ref": "#/$defs/positive"}, "max_upload_bytes": {"$ref": "#/$defs/positive"}, "max_pixels": {"$ref": "#/$defs/positive"}, "max_pages": {"$ref": "#/$defs/positive"}, "media_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "rate_limits": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["operation_id", "window_seconds", "max_requests", "max_inflight"], "properties": {"operation_id": {"type": "string", "minLength": 1}, "window_seconds": {"$ref": "#/$defs/positive"}, "max_requests": {"$ref": "#/$defs/positive"}, "max_inflight": {"$ref": "#/$defs/positive"}}}}}},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["task_type", "queue_wait_seconds", "execution_seconds", "lease_seconds", "heartbeat_seconds", "visibility_timeout_seconds", "max_attempts", "retry_delays_seconds", "max_concurrency"], "properties": {"task_type": {"enum": ["file_validation", "ocr", "assessment", "alert_evaluation", "summary", "notification", "disposition", "reconcile"]}, "queue_wait_seconds": {"$ref": "#/$defs/positive"}, "execution_seconds": {"$ref": "#/$defs/positive"}, "lease_seconds": {"$ref": "#/$defs/positive"}, "heartbeat_seconds": {"$ref": "#/$defs/positive"}, "visibility_timeout_seconds": {"$ref": "#/$defs/positive"}, "max_attempts": {"$ref": "#/$defs/positive"}, "retry_delays_seconds": {"type": "array", "items": {"$ref": "#/$defs/positive"}}, "max_concurrency": {"$ref": "#/$defs/positive"}}}},
    "providers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "config_id", "enabled", "endpoint", "secret_ref", "region", "processing_basis_ref", "connect_timeout_ms", "read_timeout_ms", "total_timeout_ms", "submit_retries", "query_attempts", "query_delays_seconds", "circuit_window_seconds", "circuit_failure_threshold", "circuit_open_seconds", "daily_budget", "currency"], "properties": {
      "kind": {"enum": ["identity", "ocr", "voice", "notification", "object_store", "redis"]}, "config_id": {"type": "string", "format": "uuid"}, "enabled": {"type": "boolean"}, "endpoint": {"type": "string", "format": "uri"}, "secret_ref": {"type": "string", "minLength": 1}, "region": {"type": "string", "minLength": 1}, "processing_basis_ref": {"type": "string", "minLength": 1}, "connect_timeout_ms": {"$ref": "#/$defs/positive"}, "read_timeout_ms": {"$ref": "#/$defs/positive"}, "total_timeout_ms": {"$ref": "#/$defs/positive"}, "submit_retries": {"const": 0}, "query_attempts": {"type": "integer", "minimum": 0}, "query_delays_seconds": {"type": "array", "items": {"$ref": "#/$defs/positive"}}, "circuit_window_seconds": {"$ref": "#/$defs/positive"}, "circuit_failure_threshold": {"$ref": "#/$defs/positive"}, "circuit_open_seconds": {"$ref": "#/$defs/positive"}, "daily_budget": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "currency": {"type": ["string", "null"]},
      "billing_scope_key": {"type": "string", "minLength": 1},
      "reserved_cost": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
    }}},
    "retention_policy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "operations_contact_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {"positive": {"type": "integer", "minimum": 1}},
  "description": "领域校验须进一步验证期限之间的大小关系、IANA 时区、操作和任务配置唯一性、重试数组长度、秘密读取、准确配置批准及已启用能力覆盖；Schema 通过不代表配置获准。"
}
