{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation-period.schema.json",
  "title": "本人观察时段、实际采样间隔与原请求",
  "$defs": {
    "Uuid": {"$ref": "v2-protocol.schema.json#/$defs/Uuid"},
    "NullableUuid": {"$ref": "v2-protocol.schema.json#/$defs/NullableUuid"},
    "Text": {"$ref": "v2-protocol.schema.json#/$defs/Text"},
    "NullableText": {"$ref": "v2-protocol.schema.json#/$defs/NullableText"},
    "Version": {"$ref": "v2-protocol.schema.json#/$defs/Version"},
    "Ids": {"$ref": "v2-protocol.schema.json#/$defs/Ids"},
    "Texts": {"$ref": "v2-protocol.schema.json#/$defs/Texts"},
    "NullableDecimal": {"$ref": "v2-protocol.schema.json#/$defs/NullableDecimal"},
    "Input": {"type": "object", "additionalProperties": false, "required": ["expected_version", "start", "end", "label", "episode_id", "reason"],
      "properties": {"expected_version": {"oneOf": [{"$ref": "#/$defs/Version"}, {"type": "null"}]},
        "start": {"$ref": "v2-protocol.schema.json#/$defs/MedicalTimeInput"}, "end": {"$ref": "v2-protocol.schema.json#/$defs/MedicalTimeInput"},
        "label": {"$ref": "#/$defs/NullableText"}, "episode_id": {"$ref": "#/$defs/NullableUuid"}, "reason": {"$ref": "#/$defs/Text"}}},
    "Sampling": {"type": "object", "additionalProperties": false, "required": ["fact", "source", "document_id", "document_version_id", "page_id", "available_at", "sampling_group_id", "relation_version_ids", "range_state", "reason_codes"],
      "properties": {"fact": {"$ref": "archive-delta.schema.json#/$defs/Fact"}, "source": {"$ref": "v2-protocol.schema.json#/$defs/SourceReference"},
        "document_id": {"$ref": "#/$defs/NullableUuid"}, "document_version_id": {"$ref": "#/$defs/NullableUuid"}, "page_id": {"$ref": "#/$defs/NullableUuid"},
        "available_at": {"$ref": "v2-protocol.schema.json#/$defs/NullableTimestamp"}, "sampling_group_id": {"$ref": "#/$defs/Uuid"},
        "relation_version_ids": {"$ref": "#/$defs/Ids"}, "range_state": {"enum": ["inside", "outside", "overlap", "unknown", "not_selected"]}, "reason_codes": {"$ref": "#/$defs/Texts"}}},
    "Interval": {"type": "object", "additionalProperties": false, "required": ["before_fact_version_id", "after_fact_version_id", "actual_hours", "minimum_hours", "maximum_hours", "comparability", "reason_codes", "relation_version_ids"],
      "properties": {"before_fact_version_id": {"$ref": "#/$defs/Uuid"}, "after_fact_version_id": {"$ref": "#/$defs/Uuid"},
        "actual_hours": {"$ref": "#/$defs/NullableDecimal"}, "minimum_hours": {"$ref": "#/$defs/NullableDecimal"}, "maximum_hours": {"$ref": "#/$defs/NullableDecimal"},
        "comparability": {"enum": ["comparable", "incomparable", "unknown"]}, "reason_codes": {"$ref": "#/$defs/Texts"}, "relation_version_ids": {"$ref": "#/$defs/Ids"}}},
    "View": {"type": "object", "additionalProperties": false,
      "required": ["patient_id", "period_id", "version_id", "version", "owner_id", "label", "label_source", "episode_id", "episode_label", "created_at", "is_current", "start", "end", "timezone", "target_interval_hours", "interval_basis_ref", "interval_policy_id", "samplings", "intervals", "unknown_time_fact_ids", "reason_codes", "snapshot_version", "episode_options", "allowed_actions"],
      "properties": {"patient_id": {"$ref": "#/$defs/Uuid"}, "period_id": {"$ref": "#/$defs/NullableUuid"}, "version_id": {"$ref": "#/$defs/NullableUuid"},
        "version": {"oneOf": [{"$ref": "#/$defs/Version"}, {"type": "null"}]}, "owner_id": {"$ref": "#/$defs/NullableUuid"}, "label": {"$ref": "#/$defs/NullableText"},
        "label_source": {"enum": ["self_report", "authorized_clinical", null]}, "episode_id": {"$ref": "#/$defs/NullableUuid"}, "episode_label": {"$ref": "#/$defs/NullableText"},
        "created_at": {"$ref": "v2-protocol.schema.json#/$defs/NullableTimestamp"}, "is_current": {"type": "boolean"},
        "start": {"oneOf": [{"$ref": "v2-protocol.schema.json#/$defs/MedicalTime"}, {"type": "null"}]},
        "end": {"oneOf": [{"$ref": "v2-protocol.schema.json#/$defs/MedicalTime"}, {"type": "null"}]}, "timezone": {"$ref": "#/$defs/NullableText"},
        "target_interval_hours": {"$ref": "#/$defs/NullableDecimal"}, "interval_basis_ref": {"$ref": "#/$defs/NullableText"}, "interval_policy_id": {"$ref": "#/$defs/NullableUuid"},
        "samplings": {"type": "array", "items": {"$ref": "#/$defs/Sampling"}}, "intervals": {"type": "array", "items": {"$ref": "#/$defs/Interval"}},
        "unknown_time_fact_ids": {"$ref": "#/$defs/Ids"}, "reason_codes": {"$ref": "#/$defs/Texts"}, "snapshot_version": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "episode_options": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["episode_id", "label", "organization"],
          "properties": {"episode_id": {"$ref": "#/$defs/Uuid"}, "label": {"$ref": "#/$defs/Text"}, "organization": {"$ref": "#/$defs/NullableText"}}}}, "allowed_actions": {"$ref": "#/$defs/Texts"}}},
    "Intent": {"type": "object", "additionalProperties": false, "required": ["operation_id", "target_key", "request_id", "schema_version", "payload"],
      "properties": {"operation_id": {"const": "observation_period_change"}, "target_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "request_id": {"$ref": "#/$defs/Uuid"}, "schema_version": {"const": "2.0.0"}, "payload": {"$ref": "#/$defs/Input"}}},
    "Request": {"type": "object", "additionalProperties": false,
      "required": ["intent_id", "request_id", "operation_id", "target_key", "state", "may_retry", "generation", "expires_at", "payload_sha256", "receipt", "error_code", "period_input"],
      "properties": {"intent_id": {"$ref": "#/$defs/Uuid"}, "request_id": {"$ref": "#/$defs/Uuid"}, "operation_id": {"const": "observation_period_change"}, "target_key": {"$ref": "#/$defs/Text"},
        "state": {"enum": ["pending", "committed", "failed", "unknown"]}, "may_retry": {"type": "boolean"}, "generation": {"$ref": "#/$defs/Version"},
        "expires_at": {"$ref": "v2-protocol.schema.json#/$defs/Timestamp"}, "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt": {"oneOf": [{"$ref": "v2-protocol.schema.json#/$defs/WriteReceipt"}, {"type": "null"}]}, "error_code": {"$ref": "#/$defs/NullableText"}, "period_input": {"$ref": "#/$defs/Input"}}}
  }
}
