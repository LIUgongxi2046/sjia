{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archive-relations.schema.json",
  "$defs": {
    "Uuid": {"$ref": "v2-protocol.schema.json#/$defs/Uuid"},
    "Version": {"$ref": "v2-protocol.schema.json#/$defs/Version"},
    "Text": {"type": "string", "minLength": 1, "maxLength": 16000, "pattern": "\\S"},
    "Operation": {"enum": ["archive_relation_create", "archive_relation_update", "archive_relation_verify"]},
    "RelationInput": {"$ref": "v2-protocol.schema.json#/$defs/RelationInput"},
    "RelationChangeInput": {"$ref": "v2-protocol.schema.json#/$defs/RelationChangeInput"},
    "RelationVerificationInput": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_version", "verification_id", "evidence_ref", "reason"],
      "properties": {"expected_version": {"$ref": "#/$defs/Version"}, "verification_id": {"$ref": "#/$defs/Uuid"}, "evidence_ref": {"$ref": "#/$defs/Text"}, "reason": {"$ref": "#/$defs/Text"}}
    },
    "RelationIntentInput": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "target_key", "request_id", "schema_version", "payload"],
      "properties": {"operation_id": {"$ref": "#/$defs/Operation"}, "target_key": {"$ref": "#/$defs/Text"}, "request_id": {"$ref": "#/$defs/Uuid"}, "schema_version": {"const": "2.0.0"}, "payload": {"type": "object"}}
    },
    "RelationRequestLookup": {
      "type": "object", "additionalProperties": false, "required": ["lookup", "operation_id", "target_key"],
      "properties": {"lookup": {"const": "request_id"}, "operation_id": {"$ref": "#/$defs/Operation"}, "target_key": {"$ref": "#/$defs/Text"}}
    },
    "RelationSource": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "label", "record_id", "record_version_id", "field_code", "report_identifier", "medical_time", "source", "object_version", "checksum"],
      "properties": {
        "kind": {"enum": ["file", "fact"]}, "id": {"$ref": "#/$defs/Uuid"}, "label": {"$ref": "#/$defs/Text"},
        "record_id": {"$ref": "v2-protocol.schema.json#/$defs/NullableUuid"}, "record_version_id": {"$ref": "v2-protocol.schema.json#/$defs/NullableUuid"},
        "field_code": {"type": ["string", "null"]}, "report_identifier": {"type": ["string", "null"]},
        "medical_time": {"anyOf": [{"type": "null"}, {"$ref": "protocol.schema.json#/$defs/MedicalTime"}]},
        "source": {"anyOf": [{"type": "null"}, {"$ref": "v2-protocol.schema.json#/$defs/SourceReference"}]},
        "object_version": {"type": ["string", "null"]}, "checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "RelationCandidate": {
      "type": "object", "additionalProperties": false, "required": ["source_kind", "left_id", "right_id", "suggested_types", "reason_codes", "status"],
      "properties": {"source_kind": {"enum": ["file", "fact"]}, "left_id": {"$ref": "#/$defs/Uuid"}, "right_id": {"$ref": "#/$defs/Uuid"}, "suggested_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "v2-protocol.schema.json#/$defs/RelationType"}}, "reason_codes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Text"}}, "status": {"const": "proposed"}}
    },
    "RelationDirectory": {
      "type": "object", "additionalProperties": false, "required": ["patient_id", "sources", "candidates", "relations", "snapshot_version", "next_cursor"],
      "properties": {"patient_id": {"$ref": "#/$defs/Uuid"}, "sources": {"type": "array", "items": {"$ref": "#/$defs/RelationSource"}}, "candidates": {"type": "array", "items": {"$ref": "#/$defs/RelationCandidate"}}, "relations": {"type": "array", "items": {"$ref": "v2-protocol.schema.json#/$defs/RelationView"}}, "snapshot_version": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "next_cursor": {"type": ["string", "null"]}}
    },
    "RelationRequestView": {
      "type": "object", "additionalProperties": false,
      "required": ["intent_id", "request_id", "operation_id", "target_key", "prepared_at", "state", "may_retry", "receipt", "error_code", "generation", "expires_at", "payload_sha256", "relation_input"],
      "properties": {"intent_id": {"$ref": "#/$defs/Uuid"}, "request_id": {"$ref": "#/$defs/Uuid"}, "operation_id": {"$ref": "#/$defs/Operation"}, "target_key": {"$ref": "#/$defs/Text"}, "prepared_at": {"type": "string", "format": "date-time"}, "state": {"enum": ["pending", "committed", "failed", "unknown"]}, "may_retry": {"type": "boolean"}, "receipt": {"anyOf": [{"type": "null"}, {"$ref": "v2-protocol.schema.json#/$defs/WriteReceipt"}]}, "error_code": {"type": ["string", "null"]}, "generation": {"$ref": "#/$defs/Version"}, "expires_at": {"type": "string", "format": "date-time"}, "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "relation_input": {"type": "object"}}
    }
  }
}
