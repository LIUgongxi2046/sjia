# 复制本文件为 backend/.env 并填入真实值；backend/.env 已加入 .gitignore，不会提交。
# 敏感密钥只写在本文件或进程环境变量，不进入代码、日志或版本库。

# —— 身份与会话 ——
SJIA_SECRET_KEY=请替换为随机密钥
SJIA_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SJIA_ENVIRONMENT=test

# —— 数据库（本地开发默认 127.0.0.1:5433） ——
SJIA_DB_NAME=sjia_dev
SJIA_DB_USER=sjia
SJIA_DB_PASSWORD=sjia_dev_password
SJIA_DB_HOST=127.0.0.1
SJIA_DB_PORT=5433

# —— Redis ——
SJIA_REDIS_URL=redis://127.0.0.1:6379/0
SJIA_CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# API 与 Worker 必须使用同一持久化目录；Compose 已挂载共享命名卷。
SJIA_FILE_OBJECT_ROOT=

# —— OCR 提供方（D03）：报告识别密钥与端点 ——
# 密钥写在此处，由 config/settings/base.py 通过 load_dotenv 读取，
# 供 recognition 服务调用 OCR 提供方时使用；留空时识别任务保持未配置状态。
SJIA_OCR_API_KEY=
SJIA_OCR_API_URL=
SJIA_OCR_MODEL=

# —— 大模型提供方（火山方舟 Ark）：语音结构化快速记录 ——
SJIA_ARK_API_KEY=
SJIA_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SJIA_ARK_MODEL=
SJIA_ARK_VISION_MODEL=

# 配置证明文件的批准目录与单个文件字节上限；由实际部署人员填写。
SJIA_CONFIG_EVIDENCE_ROOT=
SJIA_CONFIG_EVIDENCE_MAX_BYTES=

# Telemetry transport is OFF until an operator approves this exact collector.
# No patient content, resource IDs, URLs or credentials are span attributes.
SJIA_OTEL_EXPORT_ENABLED=0
SJIA_OTEL_SAMPLE_RATIO=0.1
SJIA_OTEL_TRACES_ENDPOINT=
