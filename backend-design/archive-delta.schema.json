{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "archive-delta.schema.json", "title": "新增内容、明确基准与准确来源",
  "$defs": {
    "Uuid": {"$ref": "v2-protocol.schema.json#/$defs/Uuid"},
    "NullableUuid": {"type": ["string", "null"], "format": "uuid"},
    "Input": {"type": "object", "additionalProperties": false, "required": ["baseline_batch_id", "baseline_document_version_ids"],
      "properties": {"baseline_batch_id": {"$ref": "#/$defs/NullableUuid"}, "baseline_document_version_ids": {"type": "array", "uniqueItems": true, "maxItems": 100, "items": {"$ref": "#/$defs/Uuid"}}}},
    "Source": {"type": "object", "additionalProperties": false,
      "required": ["document_id", "document_version_id", "page_id", "file_page_id", "file_id", "object_version", "checksum", "record_version_id", "field_id", "fact_version_id", "anchor_id"],
      "properties": {"document_id": {"$ref": "#/$defs/Uuid"}, "document_version_id": {"$ref": "#/$defs/Uuid"}, "page_id": {"$ref": "#/$defs/Uuid"},
        "file_page_id": {"$ref": "#/$defs/Uuid"}, "file_id": {"$ref": "#/$defs/Uuid"}, "object_version": {"type": "string", "minLength": 1}, "checksum": {"$ref": "v2-protocol.schema.json#/$defs/Digest"},
        "record_version_id": {"$ref": "#/$defs/NullableUuid"}, "field_id": {"$ref": "#/$defs/NullableUuid"}, "fact_version_id": {"$ref": "#/$defs/NullableUuid"}, "anchor_id": {"$ref": "#/$defs/NullableUuid"}}},
    "Fact": {"type": "object", "additionalProperties": false,
      "required": ["fact_version_id", "record_version_id", "field_id", "field_code", "concept_code", "original_name", "value_type", "value_state", "raw_text", "raw_numeric", "raw_unit", "qualifier", "method", "categorical_value", "medical_time", "context_type", "assertion_state", "verification_status"],
      "properties": {"fact_version_id": {"$ref": "#/$defs/Uuid"}, "record_version_id": {"$ref": "#/$defs/Uuid"}, "field_id": {"$ref": "#/$defs/Uuid"}, "field_code": {"type": "string", "minLength": 1},
        "concept_code": {"type": ["string", "null"]}, "original_name": {"type": ["string", "null"]}, "value_type": {"enum": ["decimal", "text", "time", "categorical"]}, "value_state": {"enum": ["known", "unknown", "invalid"]},
        "raw_text": {"type": ["string", "null"]}, "raw_numeric": {"oneOf": [{"$ref": "v2-protocol.schema.json#/$defs/Decimal"}, {"type": "null"}]},
        "raw_unit": {"type": ["string", "null"]}, "qualifier": {"type": ["string", "null"]}, "method": {"type": ["string", "null"]}, "categorical_value": {"type": ["string", "null"]},
        "medical_time": {"oneOf": [{"$ref": "v2-protocol.schema.json#/$defs/MedicalTime"}, {"type": "null"}]}, "context_type": {"type": "string"}, "assertion_state": {"type": "string"},
        "verification_status": {"enum": ["unverified", "pending", "verified", "needs_correction", "revoked"]}}},
    "Item": {"type": "object", "additionalProperties": false,
      "required": ["item_id", "kind", "title", "before", "after", "source_refs", "relation_version_ids", "reason_codes"],
      "properties": {"item_id": {"$ref": "#/$defs/Uuid"}, "kind": {"enum": ["document", "fact", "duplicate", "conflict", "unknown_time", "unverified", "change"]}, "title": {"type": "string", "minLength": 1},
        "before": {"oneOf": [{"$ref": "#/$defs/Fact"}, {"type": "null"}]}, "after": {"oneOf": [{"$ref": "#/$defs/Fact"}, {"type": "null"}]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Source"}}, "relation_version_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Uuid"}},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "View": {"type": "object", "additionalProperties": false,
      "required": ["delta_id", "patient_id", "batch_id", "baseline_batch_id", "baseline_document_version_ids", "current_document_version_ids", "task_id", "status", "validity", "reason_codes", "items", "created_at"],
      "properties": {"delta_id": {"$ref": "#/$defs/Uuid"}, "patient_id": {"$ref": "#/$defs/Uuid"}, "batch_id": {"$ref": "#/$defs/Uuid"}, "baseline_batch_id": {"$ref": "#/$defs/NullableUuid"},
        "baseline_document_version_ids": {"type": "array", "items": {"$ref": "#/$defs/Uuid"}}, "current_document_version_ids": {"type": "array", "items": {"$ref": "#/$defs/Uuid"}}, "task_id": {"$ref": "#/$defs/Uuid"},
        "status": {"enum": ["accepted", "running", "completed", "failed", "superseded"]}, "validity": {"enum": ["valid", "invalid"]}, "reason_codes": {"type": "array", "items": {"type": "string"}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/Item"}}, "created_at": {"type": "string", "format": "date-time"}}},
    "Intent": {"type": "object", "additionalProperties": false, "required": ["operation_id", "target_key", "request_id", "schema_version", "payload"],
      "properties": {"operation_id": {"const": "archive_delta_create"}, "target_key": {"type": "string", "minLength": 1, "maxLength": 256}, "request_id": {"$ref": "#/$defs/Uuid"}, "schema_version": {"const": "2.0.0"}, "payload": {"$ref": "#/$defs/Input"}}},
    "Request": {"type": "object", "additionalProperties": false, "required": ["intent_id", "request_id", "operation_id", "target_key", "state", "may_retry", "receipt", "error_code", "generation", "expires_at", "payload_sha256", "delta_input"],
      "properties": {"intent_id": {"$ref": "#/$defs/Uuid"}, "request_id": {"$ref": "#/$defs/Uuid"}, "operation_id": {"const": "archive_delta_create"}, "target_key": {"type": "string"},
        "state": {"enum": ["pending", "committed", "failed", "unknown"]}, "may_retry": {"type": "boolean"}, "receipt": {"oneOf": [{"$ref": "v2-protocol.schema.json#/$defs/WriteReceipt"}, {"type": "null"}]},
        "error_code": {"type": ["string", "null"]}, "generation": {"$ref": "v2-protocol.schema.json#/$defs/Version"}, "expires_at": {"type": "string", "format": "date-time"},
        "payload_sha256": {"$ref": "v2-protocol.schema.json#/$defs/Digest"}, "delta_input": {"$ref": "#/$defs/Input"}}},
    "Task": {"type": "object", "additionalProperties": false, "required": ["task_id", "patient_id", "status", "status_version", "result_type", "result_ref", "error_code"],
      "properties": {"task_id": {"$ref": "#/$defs/Uuid"}, "patient_id": {"$ref": "#/$defs/Uuid"}, "status": {"enum": ["completed", "superseded"]}, "status_version": {"$ref": "v2-protocol.schema.json#/$defs/Version"},
        "result_type": {"const": "archive_delta"}, "result_ref": {"$ref": "#/$defs/Uuid"}, "error_code": {"type": ["string", "null"]}}}
  }
}
