{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["started_at", "finished_at", "evidence_type", "input_source", "results"],
  "properties": {
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "evidence_type": {"const": "SECURITY"},
    "input_source": {"type": "string"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route", "method", "expected_status", "actual_status", "status", "response_sha256"],
        "properties": {
          "route": {"type": "string"},
          "method": {"enum": ["GET", "POST", "PUT"]},
          "expected_status": {"type": "integer"},
          "actual_status": {"type": "integer"},
          "status": {"enum": ["PASS", "FAIL"]},
          "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
