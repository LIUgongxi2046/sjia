{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sjia:simulation-provider-deletion:1",
  "title": "Simulation provider object deletion protocol",
  "x-simulation-only": true,
  "$defs": {
    "DeletionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "provider_id", "object_id", "object_version", "checksum", "size_bytes", "requested_at"],
      "properties": {
        "schema_version": {"const": "provider-delete-request-1"},
        "request_id": {"type": "string", "format": "uuid"},
        "provider_id": {"const": "SIMULATION_PROVIDER"},
        "object_id": {"type": "string", "format": "uuid"},
        "object_version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "requested_at": {"type": "string", "format": "date-time"}
      }
    },
    "DeletionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "provider_id", "object_id", "object_version", "checksum", "size_bytes", "outcome", "observed_at", "evidence_sha256"],
      "properties": {
        "schema_version": {"const": "provider-delete-receipt-1"},
        "request_id": {"type": "string", "format": "uuid"},
        "provider_id": {"const": "SIMULATION_PROVIDER"},
        "object_id": {"type": "string", "format": "uuid"},
        "object_version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "outcome": {"enum": ["deleted", "not_found", "unknown"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
