{
  "$defs": {
    "S3ObjectReference": {"type": "object", "additionalProperties": false,
      "required": ["binding_sha256", "object_key", "version_id", "etag", "checksum", "size_bytes"],
      "properties": {"schema_version": {"const": "s3-object-reference-1"},
        "binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "object_key": {"type": "string", "minLength": 1},
        "version_id": {"type": "string", "minLength": 1, "not": {"const": "null"}},
        "etag": {"type": "string", "minLength": 1}, "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}, "encryption": {"const": "AES256"}}},
    "S3ObjectTarget": {"type": "object", "additionalProperties": false,
      "required": ["kind", "file_id", "object_version"], "properties": {
        "kind": {"const": "s3_object"}, "file_id": {"type": "string", "format": "uuid"},
        "object_version": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": ".*\\S.*"}}},
    "S3ObjectProof": {"type": "object", "additionalProperties": false,
      "required": ["kind", "file_id", "object_version", "object_key", "checksum", "size_bytes", "operation_id", "storage_reference"],
      "properties": {"kind": {"const": "s3_object"}, "file_id": {"type": "string", "format": "uuid"},
        "object_version": {"$ref": "#/$defs/LocalObjectProof/properties/object_version"},
        "object_key": {"$ref": "#/$defs/LocalObjectProof/properties/object_key"},
        "checksum": {"$ref": "#/$defs/LocalObjectProof/properties/checksum"},
        "size_bytes": {"$ref": "#/$defs/LocalObjectProof/properties/size_bytes"},
        "operation_id": {"type": "string", "format": "uuid"}, "storage_reference": {"$ref": "#/$defs/S3ObjectReference"}}},
    "S3ContentManifest": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "patient_id", "policy_id", "policy_version", "policy_sha256", "registry_sha256",
        "preservation_sha256", "mode", "environment", "hold_id", "hold_version", "roots", "items", "obligations", "created_at", "storage_binding_sha256"],
      "properties": {
        "family_request_id": {"$ref": "#/$defs/ContentManifest/properties/family_request_id"},
        "schema_version": {"const": "content-disposition-manifest-2"},
        "patient_id": {"$ref": "#/$defs/ContentManifest/properties/patient_id"},
        "policy_id": {"$ref": "#/$defs/ContentManifest/properties/policy_id"},
        "policy_version": {"$ref": "#/$defs/ContentManifest/properties/policy_version"},
        "policy_sha256": {"$ref": "#/$defs/ContentManifest/properties/policy_sha256"},
        "registry_sha256": {"$ref": "#/$defs/ContentManifest/properties/registry_sha256"},
        "preservation_sha256": {"$ref": "#/$defs/ContentManifest/properties/preservation_sha256"},
        "mode": {"$ref": "#/$defs/ContentManifest/properties/mode"},
        "environment": {"$ref": "#/$defs/ContentManifest/properties/environment"},
        "hold_id": {"$ref": "#/$defs/ContentManifest/properties/hold_id"},
        "hold_version": {"$ref": "#/$defs/ContentManifest/properties/hold_version"},
        "roots": {"type": "array", "minItems": 1, "maxItems": 5000,
          "items": {"oneOf": [{"$ref": "#/$defs/DatabaseTarget"}, {"$ref": "#/$defs/S3ObjectTarget"}]}},
        "items": {"type": "array", "minItems": 1, "maxItems": 5000,
          "items": {"oneOf": [{"$ref": "#/$defs/DatabaseProof"}, {"$ref": "#/$defs/S3ObjectProof"}]}},
        "obligations": {"$ref": "#/$defs/ContentManifest/properties/obligations"},
        "created_at": {"$ref": "#/$defs/ContentManifest/properties/created_at"},
        "storage_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "S3ErasedReceipt": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "manifest_sha256", "journal_sequence", "logical_payload_erased", "all_copies_erased",
        "unverified_copy_obligations", "proof_scope", "storage_binding_sha256"],
      "properties": {"schema_version": {"const": "content-disposition-receipt-2"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "journal_sequence": {"type": "integer", "minimum": 1}, "logical_payload_erased": {"const": true},
        "all_copies_erased": {"const": false},
        "unverified_copy_obligations": {"$ref": "#/$defs/ErasedReceipt/properties/unverified_copy_obligations"},
        "proof_scope": {"const": "current_database_payload_and_controlled_s3_version_absence"},
        "storage_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "ContentManifest": {
      "additionalProperties": false,
      "properties": {
        "family_request_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Request Id"
        },
        "schema_version": {
          "const": "content-disposition-manifest-1",
          "title": "Schema Version",
          "type": "string"
        },
        "patient_id": {
          "format": "uuid",
          "title": "Patient Id",
          "type": "string"
        },
        "policy_id": {
          "format": "uuid",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "registry_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registry Sha256",
          "type": "string"
        },
        "preservation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preservation Sha256",
          "type": "string"
        },
        "mode": {
          "enum": [
            "retain",
            "revoke_access",
            "erase_selected_content"
          ],
          "title": "Mode",
          "type": "string"
        },
        "environment": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Environment",
          "type": "string"
        },
        "hold_id": {
          "format": "uuid",
          "title": "Hold Id",
          "type": "string"
        },
        "hold_version": {
          "minimum": 1,
          "title": "Hold Version",
          "type": "integer"
        },
        "roots": {
          "items": {
            "discriminator": {
              "mapping": {
                "database": "#/$defs/DatabaseTarget",
                "local_object": "#/$defs/LocalObjectTarget"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DatabaseTarget"
              },
              {
                "$ref": "#/$defs/LocalObjectTarget"
              }
            ]
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Roots",
          "type": "array"
        },
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "database": "#/$defs/DatabaseProof",
                "local_object": "#/$defs/LocalObjectProof"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DatabaseProof"
              },
              {
                "$ref": "#/$defs/LocalObjectProof"
              }
            ]
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "obligations": {
          "items": {
            "enum": [
              "physical_database_storage",
              "external_provider_copies",
              "backup_copies"
            ],
            "type": "string"
          },
          "title": "Obligations",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "patient_id",
        "policy_id",
        "policy_version",
        "policy_sha256",
        "registry_sha256",
        "preservation_sha256",
        "mode",
        "environment",
        "hold_id",
        "hold_version",
        "roots",
        "items",
        "obligations",
        "created_at"
      ],
      "title": "ContentManifest",
      "type": "object"
    },
    "DatabaseProof": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "database",
          "title": "Kind",
          "type": "string"
        },
        "adapter": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Adapter",
          "type": "string"
        },
        "object_id": {
          "format": "uuid",
          "title": "Object Id",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Version",
          "type": "string"
        },
        "row_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Row Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "adapter",
        "object_id",
        "version",
        "row_sha256"
      ],
      "title": "DatabaseProof",
      "type": "object"
    },
    "DatabaseTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "database",
          "title": "Kind",
          "type": "string"
        },
        "adapter": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Adapter",
          "type": "string"
        },
        "object_id": {
          "format": "uuid",
          "title": "Object Id",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "adapter",
        "object_id",
        "version"
      ],
      "title": "DatabaseTarget",
      "type": "object"
    },
    "ErasedReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "content-disposition-receipt-1",
          "title": "Schema Version",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "journal_sequence": {
          "minimum": 1,
          "title": "Journal Sequence",
          "type": "integer"
        },
        "logical_payload_erased": {
          "const": true,
          "title": "Logical Payload Erased",
          "type": "boolean"
        },
        "all_copies_erased": {
          "const": false,
          "title": "All Copies Erased",
          "type": "boolean"
        },
        "unverified_copy_obligations": {
          "items": {
            "enum": [
              "physical_database_storage",
              "external_provider_copies",
              "backup_copies"
            ],
            "type": "string"
          },
          "title": "Unverified Copy Obligations",
          "type": "array"
        },
        "proof_scope": {
          "const": "current_database_payload_and_controlled_local_path_absence",
          "title": "Proof Scope",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "manifest_sha256",
        "journal_sequence",
        "logical_payload_erased",
        "all_copies_erased",
        "unverified_copy_obligations",
        "proof_scope"
      ],
      "title": "ErasedReceipt",
      "type": "object"
    },
    "LocalObjectProof": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local_object",
          "title": "Kind",
          "type": "string"
        },
        "file_id": {
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "object_version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Object Version",
          "type": "string"
        },
        "object_key": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Object Key",
          "type": "string"
        },
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "file_id",
        "object_version",
        "object_key",
        "checksum",
        "size_bytes",
        "operation_id"
      ],
      "title": "LocalObjectProof",
      "type": "object"
    },
    "LocalObjectTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local_object",
          "title": "Kind",
          "type": "string"
        },
        "file_id": {
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "object_version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Object Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "file_id",
        "object_version"
      ],
      "title": "LocalObjectTarget",
      "type": "object"
    },
    "RetainedReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "content-disposition-receipt-1",
          "title": "Schema Version",
          "type": "string"
        },
        "logical_payload_erased": {
          "const": false,
          "title": "Logical Payload Erased",
          "type": "boolean"
        },
        "all_copies_erased": {
          "const": false,
          "title": "All Copies Erased",
          "type": "boolean"
        },
        "retained_until": {
          "format": "date-time",
          "title": "Retained Until",
          "type": "string"
        },
        "recheck_at": {
          "format": "date-time",
          "title": "Recheck At",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "logical_payload_erased",
        "all_copies_erased",
        "retained_until",
        "recheck_at"
      ],
      "title": "RetainedReceipt",
      "type": "object"
    },
    "RevokedReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "content-disposition-receipt-1",
          "title": "Schema Version",
          "type": "string"
        },
        "logical_payload_erased": {
          "const": false,
          "title": "Logical Payload Erased",
          "type": "boolean"
        },
        "all_copies_erased": {
          "const": false,
          "title": "All Copies Erased",
          "type": "boolean"
        },
        "access_revoked": {
          "const": true,
          "title": "Access Revoked",
          "type": "boolean"
        },
        "journal_sequence": {
          "minimum": 1,
          "title": "Journal Sequence",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "logical_payload_erased",
        "all_copies_erased",
        "access_revoked",
        "journal_sequence"
      ],
      "title": "RevokedReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "content-disposition-plan-view-1",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "patient_id": {
      "format": "uuid",
      "title": "Patient Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "preview",
        "approved",
        "retained",
        "access_revoked",
        "erasing",
        "logical_erasure_complete"
      ],
      "title": "Status",
      "type": "string"
    },
    "manifest": {
      "oneOf": [{"$ref": "#/$defs/ContentManifest"}, {"$ref": "#/$defs/S3ContentManifest"}]
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approved At"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completed At"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetainedReceipt"
        },
        {
          "$ref": "#/$defs/RevokedReceipt"
        },
        {
          "$ref": "#/$defs/ErasedReceipt"
        },
        {
          "$ref": "#/$defs/S3ErasedReceipt"
        },
        {
          "type": "null"
        }
      ],
      "title": "Receipt"
    },
    "runtime_execution_enabled": {
      "title": "Runtime Execution Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "patient_id",
    "status",
    "manifest",
    "manifest_sha256",
    "approved_at",
    "completed_at",
    "receipt",
    "runtime_execution_enabled"
  ],
  "title": "ContentPlanView",
  "type": "object"
}
